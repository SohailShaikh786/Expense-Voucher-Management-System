datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  EMPLOYEE
  DIRECTOR
  ACCOUNTS
}

enum VoucherStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum ExpenseCategory {
  TRAVEL
  FOOD
  ACCOMMODATION
  OFFICE_SUPPLIES
  EQUIPMENT
  UTILITIES
  TRAINING
  OTHER
}

model User {
  id               String       @id @default(uuid())
  name             String
  email            String       @unique
  passwordHash     String
  role             Role         @default(EMPLOYEE)
  department       String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  vouchersCreated  Voucher[]    @relation("EmployeeVouchers")
  vouchersReviewed Voucher[]    @relation("DirectorVouchers")
  auditLogs        AuditLog[]

  @@map("users")
}

model Voucher {
  id                   String          @id @default(uuid())
  voucherNumber        String          @unique
  voucherDate          DateTime        @default(now())
  expenseDate          DateTime
  departmentName       String
  expenseTitle         String
  expenseCategory      ExpenseCategory @default(OTHER)
  expenseDescription  String?         @db.Text
  amount               Decimal         @db.Decimal(12, 2)
  status               VoucherStatus   @default(DRAFT)

  employeeId           String
  employee             User            @relation("EmployeeVouchers", fields: [employeeId], references: [id])
  employeeSignatureUrl String?

  directorId           String?
  director             User?           @relation("DirectorVouchers", fields: [directorId], references: [id])
  directorSignatureUrl String?

  submittedAt          DateTime?
  approvalDate         DateTime?
  rejectionReason      String?         @db.Text

  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  auditLogs            AuditLog[]

  @@index([status])
  @@index([employeeId])
  @@index([voucherNumber])
  @@map("vouchers")
}

model AuditLog {
  id            String   @id @default(uuid())
  voucherId     String
  voucher       Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  action        String
  performedById String
  performedBy   User     @relation(fields: [performedById], references: [id])
  notes         String?  @db.Text
  timestamp     DateTime @default(now())

  @@index([voucherId])
  @@map("audit_logs")
}
